# ── Sengoku Soldier — Environment Configuration ──
# Copy this file to .env and fill in your API keys.
# NEVER commit .env — it is git-ignored.

# ── Model Selection (for local GM proxy mode) ──
# The game tries these models in order (best → fallback):
#   1. ANTHROPIC_API_KEY  → Claude 3.7 Sonnet (best for storytelling)
#   2. GOOGLE_API_KEY     → Gemini 2.5 Pro (second best)
#   3. DEEPSEEK_API_KEY   → DeepSeek Chat (good value)
#   4. OPENAI_API_KEY     → GPT-4o (OpenAI)
#   5. OMNIROUTE_URL + OMNIROUTE_KEY → OmniRoute proxy (any OpenAI-compatible model)
#   6. OLLAMA_URL         → Local Ollama (if running)
#
# Only set the keys you have. The game automatically uses the best available.

# Anthropic (Claude) — best for narrative GM
ANTHROPIC_API_KEY=""

# Google (Gemini Pro)
GOOGLE_API_KEY=""

# DeepSeek
DEEPSEEK_API_KEY=""

# OpenAI
OPENAI_API_KEY=""

# OmniRoute (proxy to multiple models)
OMNIROUTE_URL="http://localhost:20128/v1"
OMNIROUTE_KEY=""

# Ollama local
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:3b"

# ── Game Settings ──
# Set to 'local' to use the local GM proxy at http://localhost:20129
# (requires at least one API key above)
GM_MODE="local"
