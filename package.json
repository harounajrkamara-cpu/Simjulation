{
  "name": "sengoku-soldier",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Deterministic text simulation: Li Hattori, from slave to great general.",
  "scripts": {
    "play": "tsx cli/play.ts",
    "turn": "tsx cli/turn.ts",
    "web": "vite web",
    "build:web": "vite build web --outDir ../dist-web --emptyOutDir",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.4"
  }
}
